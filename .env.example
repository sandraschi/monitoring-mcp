# Monitoring MCP Configuration
# Copy this file to .env and fill in your values

# Web authentication (REQUIRED for web UI)
MCP_WEB_USER=admin
MCP_WEB_PASSWORD=change_me

# Transport (stdio default; http for compose)
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=10851

# Grafana connection
MONITORING_MCP_GRAFANA_URL=http://localhost:3000
MONITORING_MCP_GRAFANA_API_KEY=
# MONITORING_MCP_GRAFANA_USERNAME=admin
# MONITORING_MCP_GRAFANA_PASSWORD=

# Prometheus connection
MONITORING_MCP_PROMETHEUS_URL=http://localhost:9090
# MONITORING_MCP_PROMETHEUS_BEARER_TOKEN=
# MONITORING_MCP_PROMETHEUS_USERNAME=
# MONITORING_MCP_PROMETHEUS_PASSWORD=

# Loki connection
MONITORING_MCP_LOKI_URL=http://localhost:3100
# MONITORING_MCP_LOKI_BEARER_TOKEN=

# Alertmanager (silences)
MONITORING_MCP_ALERTMANAGER_URL=http://localhost:9093

# Storage / crypto (key auto-persisted under storage path if unset)
# MONITORING_MCP_STORAGE_PATH=
# MONITORING_MCP_ENCRYPTION_KEY=

# Performance
MONITORING_MCP_REQUEST_TIMEOUT=30
MONITORING_MCP_MAX_RESULTS_LIMIT=1000
MONITORING_MCP_ENABLE_SAMPLING=true
MONITORING_MCP_SAMPLING_THRESHOLD=10000
MONITORING_MCP_SAMPLING_RATE=0.1
MONITORING_MCP_ENABLE_CACHE=true
MONITORING_MCP_CACHE_TTL_SECONDS=300
MONITORING_MCP_LOG_LEVEL=INFO
